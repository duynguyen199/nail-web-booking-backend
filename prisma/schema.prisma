generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String           @id @default(uuid())
  username        String           @unique
  password        String
  email           String           @unique
  phoneNumber     String
  role            UserRole         @default(CLIENT)
  avatarUrl       String?
  createdAt       DateTime         @default(now())

  nailTechProfile NailTechProfile?
  clientAppointments Appointment[] @relation("ClientAppointments")
  techAppointments   Appointment[] @relation("TechAppointments")
  availabilities     Availability[]  // ✅ one user (tech) → many availabilities
}
model Service {
  id              String   @id @default(uuid())
  name            String   @unique
  description     String
  durationMinutes Int
  price           Float
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  //relations
  appointments Appointment[]
}

model NailTechProfile {
  id            String        @id @default(uuid())
  userId        String        @unique
  bio           String?
  yearOfExp     Int           @default(0)
  bufferMinutes Int           @default(15)
  workingHours  Json
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  ratingAvg     Float         @default(0.0)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Availability {
  id        String             @id @default(uuid())
  techId    String
  startAt   DateTime
  endAt     DateTime
  status    AvailabilityStatus @default(AVAILABLE)
  tech      User               @relation(fields: [techId], references: [id], onDelete: Cascade)

  @@index([techId])
}
model Appointment {
  id        String             @id @default(uuid())
  clientId  String
  techId    String
  serviceId String

  startAt   DateTime
  endAt     DateTime
  status    AppointmentStatus  @default(PENDING)
  reason    String?
  createdAt DateTime           @default(now())

  // Relations
  client  User    @relation("ClientAppointments", fields: [clientId], references: [id])
  tech    User    @relation("TechAppointments", fields: [techId], references: [id])
  service Service @relation(fields: [serviceId], references: [id])

  @@index([clientId])
  @@index([techId])
  @@index([serviceId])
}

enum AppointmentStatus{
  PENDING
  CONFIRMED
  DENIED
  CANCELLED
  COMPLETED
  NO_SHOW
}
enum AvailabilityStatus {
  AVAILABLE
  BUSY
  LUNCH
  ON_HOLD
}

enum UserRole {
  CLIENT
  NAIL_TECH
  ADMIN
}
