generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String           @id @default(uuid())
  username        String           @unique
  password        String
  email           String           @unique
  phoneNumber     String
  role            UserRole         @default(CLIENT)
  avatarUrl       String?
  createdAt       DateTime         @default(now())
  nailTechProfile NailTechProfile?
}

model Service {
  id              String   @id @default(uuid())
  name            String   @unique
  description     String
  durationMinutes Int
  price           Float
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model NailTechProfile {
  id            String        @id @default(uuid())
  userId        String        @unique
  bio           String?
  yearOfExp     Int           @default(0)
  bufferMinutes Int           @default(15)
  workingHours  Json
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  ratingAvg     Float         @default(0.0)
availabilities Availability[]  // ✅ one-to-many  
user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Availability {
  id              String             @id @default(uuid())
  techId          String            
  startAt         DateTime
  endAt           DateTime
  status          AvailabilityStatus @default(AVAILABLE)
  nailTechProfile NailTechProfile    @relation(fields: [techId], references: [id], onDelete: Cascade)

  @@index([techId])
}

enum AvailabilityStatus {
  AVAILABLE
  BUSY
  LUNCH
  ON_HOLD
}

enum UserRole {
  CLIENT
  NAIL_TECH
  ADMIN
}
